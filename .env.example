# ==============================================================================
# AEGIS // GATEWAY — Environment Configuration (Enterprise V1.0)
# ==============================================================================

APP_NAME=AEGIS // GATEWAY
APP_VERSION=1.0.0-enterprise
ENVIRONMENT=production

# Database Connection:
# - Local / Zero-Dependency Autonomous Mode (SQLite Async):
DATABASE_URL=sqlite+aiosqlite:///./aegis_gateway.db
# - Enterprise Docker / PostgreSQL 15 + pgvector Mode:
# DATABASE_URL=postgresql+asyncpg://aegis:aegis_secret@db:5432/aegis_gateway

# Optional Upstream LLM API Keys
# Leave blank to run the built-in Deterministic Upstream LLM Simulator (SSE + JSON)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Zero-Trust & FinOps Governance Thresholds
DEFAULT_CACHE_THRESHOLD=0.92
DEFAULT_INJECTION_THRESHOLD=0.75
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_DAILY_BUDGET_USD=50.0
